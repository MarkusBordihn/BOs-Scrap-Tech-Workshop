{
  "id": "scrap_tech_workshop:holologs/de/intro/introduction",
  "title": "Einführung",
  "subtitle": "Die Alte Welt",
  "color": "#00FFFF",
  "lineDelay": 3.25,
  "voiceOver": "scrap_tech_workshop:holologs/de/intro/introduction",
  "displayHoloEntity": {
    "id": "scrap_tech_workshop:hololog_humanoid",
    "texture": "scrap_tech_workshop:textures/entity/hololog/hololog_humanoid.png",
    "scale": 0.5
  },
  "start": {
    "playSound": [{"id": "minecraft:block.note_block.bass", "volume": 0.8}],
    "showParticle": [{"id": "minecraft:dust", "color": "#00FFAA"}]
  },
  "lines": [
    {
      "text": "Wenn du das hörst…",
      "playSound": [{"id": "minecraft:block.note_block.hat", "volume": 0.8}],
      "showParticle": [{"id": "minecraft:dust", "color": "#00FFAA"}]
    },
    {
      "text": "dann ist die alte Welt bereits verschwunden.",
      "playSound": [{"id": "minecraft:block.beacon.activate", "pitch": 0.8}],
      "showParticle": [{"id": "minecraft:smoke", "count": 3}]
    },
    {
      "text": "Der Himmel brannte,",
      "displayBlock": {"id": "minecraft:fire", "rotationSpeed": 0.0},
      "playSound": [{"id": "minecraft:block.note_block.snare", "volume": 0.7}],
      "showParticle": [{"id": "minecraft:dust", "color": "#FF5500"}]
    },
    {
      "text": "die Städte fielen,",
      "displayBlock": {"id": "minecraft:cracked_stone_bricks"},
      "playSound": [{"id": "minecraft:ambient.cave", "volume": 0.3}]
    },
    {
      "text": "und was wir einst Technologie nannten",
      "displayBlock": {"id": "minecraft:redstone_block"}
    },
    {
      "text": "wurde im Feuer zerschmettert.",
      "displayBlock": {"id": "minecraft:blackstone"},
      "playSound": [{"id": "minecraft:entity.blaze.burn", "volume": 0.35, "pitch": 0.9}],
      "showParticle": [{"id": "minecraft:smoke", "count": 8}]
    },
    {
      "text": "Was übrig blieb… liegt zerbrochen.",
      "displayItem": {"id": "scrap_tech_workshop:metal_scrap"},
      "playSound": [{"id": "minecraft:block.redstone_torch.burnout", "volume": 0.7}],
      "showParticle": [{"id": "minecraft:portal", "count": 6}]
    },
    {
      "text": "Verrostete Platten,"
    },
    {
      "text": "zersplitterte Spulen,",
      "displayItem": {"id": "scrap_tech_workshop:coil_scrap"},
      "playSound": [{"id": "minecraft:block.glass.break", "volume": 0.3, "pitch": 0.8}]
    },
    {
      "text": "Fragmente verlorener Kraft in der Asche.",
      "playSound": [{"id": "minecraft:entity.elder_guardian.curse", "volume": 0.25, "pitch": 0.8}],
      "showParticle": [{"id": "minecraft:smoke", "count": 6}]
    },
    {
      "text": "Wir plündern nicht nach Ruhm."
    },
    {
      "text": "Wir plündern, weil das Überleben es verlangt.",
      "playSound": [
        {"id": "minecraft:block.note_block.snare", "volume": 0.7},
        {"id": "minecraft:entity.enderman.teleport", "volume": 0.15, "pitch": 1.6}
      ],
      "showParticle": [{"id": "minecraft:crit", "count": 8}]
    },
    {
      "text": "Jeder Kondensator,",
      "displayItem": {"id": "scrap_tech_workshop:capacitor_scrap"}
    },
    {
      "text": "jede Zelle,",
      "displayItem": {"id": "scrap_tech_workshop:energy_cell_scrap"},
      "playSound": [{"id": "minecraft:block.comparator.click", "volume": 0.4, "pitch": 1.2}]
    },
    {
      "text": "jede Scherbe aus Schaltkreisen",
      "displayItem": {"id": "scrap_tech_workshop:circuit_scrap"}
    },
    {
      "text": "ist eine Chance zum Wiederaufbau.",
      "displayBlock": {"id": "minecraft:crafting_table"},
      "playSound": [{"id": "minecraft:block.beacon.activate", "volume": 0.8, "pitch": 0.9}],
      "showParticle": [{"id": "minecraft:dust", "color": "#00FFAA"}]
    },
    {
      "lineDelay": 4.75,
      "displayBlock": {"id": "minecraft:crafting_table", "rotationSpeed": 0.5},
      "playSound": [
        {"id": "minecraft:block.beacon.ambient", "volume": 0.3},
        {"id": "minecraft:block.note_block.pling", "volume": 0.2, "pitch": 1.8}
      ],
      "showParticle": [{"id": "minecraft:dust", "color": "#00FFAA", "count": 2}]
    },
    {
      "text": "Das Zeitalter polierter Legierungen"
    },
    {
      "text": "und perfekter Maschinen ist vorbei.",
      "displayItem": {"id": "minecraft:damaged_anvil"},
      "playSound": [{"id": "minecraft:entity.elder_guardian.curse", "volume": 0.2, "pitch": 0.75}],
      "showParticle": [{"id": "minecraft:smoke", "count": 6}]
    },
    {
      "text": "Jetzt wird die Zukunft aus Fragmenten geschmiedet.",
      "displayItem": {"id": "scrap_tech_workshop:alloy_scrap"},
      "playSound": [
        {"id": "minecraft:block.note_block.hat", "volume": 0.8},
        {"id": "minecraft:entity.enderman.teleport", "volume": 0.15, "pitch": 1.6}
      ],
      "showParticle": [{"id": "minecraft:portal", "count": 6}]
    },
    {
      "text": "Aus Wrackteilen.",
      "displayItem": {"id": "scrap_tech_workshop:tech_scrap"},
      "playSound": [{"id": "minecraft:ui.toast.in"}],
      "showParticle": [{"id": "minecraft:crit", "count": 10}]
    },
    {
      "text": "Aus Schrott.",
      "displayItem": {"id": "scrap_tech_workshop:iron_scrap"}
    },
    {
      "text": "💡 Tipp: Schau in dein Inventar nach neuen Gegenständen",
      "displayItem": {"id": "scrap_tech_workshop:holo_pad_scavenging_briefing_01"},
      "lineDelay": 4.0,
      "playSound": [{"id": "minecraft:block.note_block.pling", "volume": 0.5, "pitch": 1.5}],
      "showParticle": [{"id": "minecraft:dust", "color": "#FFFF00", "count": 5}]
    }
  ],
  "end": {
    "playSound": [
      {"id": "minecraft:block.beacon.deactivate", "volume": 0.9},
      {"id": "minecraft:ui.toast.in"}
    ],
    "showParticle": [{"id": "minecraft:flash"}]
  }
}
