{
  "id": "scrap_tech_workshop:holologs/de/intro/introduction",
  "title": "Einführung",
  "subtitle": "Die Alte Welt",
  "titleColor": "#00FFAA",
  "subtitleColor": "#AAAAAA",
  "lineDelayTicks": 40,
  "voiceOver": "scrap_tech_workshop:holologs/de/intro/introduction",
  "displayEntity": {
    "type": "entity",
    "id": "minecraft:villager",
    "scale": 0.5,
    "rotationSpeed": 1.0
  },
  "start": {
    "sfx": [{"id": "minecraft:block.note_block.bass", "volume": 0.8}],
    "fx": [{"id": "minecraft:dust", "color": "#00FFAA"}]
  },
  "lines": [
    {
      "text": "Wenn du das hörst…",
      "sfx": [{"id": "minecraft:block.note_block.hat", "volume": 0.8}],
      "fx": [{"id": "minecraft:dust", "color": "#00FFAA"}]
    },
    {
      "text": "dann ist die alte Welt bereits verschwunden.",
      "sfx": [{"id": "minecraft:block.beacon.activate", "pitch": 0.8}],
      "fx": [{"id": "minecraft:smoke", "count": 3}]
    },
    {
      "text": "Der Himmel brannte,",
      "displayEntity": {
        "type": "block", "id": "minecraft:fire", "scale": 0.3, "rotationSpeed": 0.0
      },
      "sfx": [{"id": "minecraft:block.note_block.snare", "volume": 0.7}],
      "fx": [{"id": "minecraft:dust", "color": "#FF5500"}]
    },
    {
      "text": "die Städte fielen,",
      "displayEntity": {"type": "block", "id": "minecraft:cracked_stone_bricks"},
      "sfx": [{"id": "minecraft:ambient.cave", "volume": 0.3}]
    },
    {
      "text": "und was wir einst Technologie nannten",
      "displayEntity": {"type": "block", "id": "minecraft:redstone_block", "scale": 0.4}
    },
    {
      "text": "wurde im Feuer zerschmettert.",
      "displayEntity": {"type": "block", "id": "minecraft:blackstone", "scale": 0.4},
      "sfx": [{"id": "minecraft:entity.blaze.burn", "volume": 0.35, "pitch": 0.9}],
      "fx": [{"id": "minecraft:smoke", "count": 8}]
    },
    {
      "text": "Was übrig blieb… liegt zerbrochen.",
      "displayEntity": {"type": "item", "id": "scrap_tech_workshop:metal_scrap", "scale": 0.6},
      "sfx": [{"id": "minecraft:block.redstone_torch.burnout", "volume": 0.7}],
      "fx": [{"id": "minecraft:portal", "count": 6}]
    },
    {
      "text": "Verrostete Platten,"
    },
    {
      "text": "zersplitterte Spulen,",
      "displayEntity": {"type": "item", "id": "scrap_tech_workshop:coil_scrap", "scale": 0.5},
      "sfx": [{"id": "minecraft:block.glass.break", "volume": 0.3, "pitch": 0.8}]
    },
    {
      "text": "Fragmente verlorener Kraft in der Asche.",
      "sfx": [{"id": "minecraft:entity.elder_guardian.curse", "volume": 0.25, "pitch": 0.8}],
      "fx": [{"id": "minecraft:smoke", "count": 6}]
    },
    {
      "text": "Wir plündern nicht nach Ruhm.",
      "displayEntity": {"type": "entity", "id": "minecraft:villager", "scale": 0.5}
    },
    {
      "text": "Wir plündern, weil das Überleben es verlangt.",
      "sfx": [
        {"id": "minecraft:block.note_block.snare", "volume": 0.7},
        {"id": "minecraft:entity.enderman.teleport", "volume": 0.15, "pitch": 1.6}
      ],
      "fx": [{"id": "minecraft:crit", "count": 8}]
    },
    {
      "text": "Jeder Kondensator,",
      "displayEntity": {"type": "item", "id": "scrap_tech_workshop:capacitor_scrap"}
    },
    {
      "text": "jede Zelle,",
      "displayEntity": {"type": "item", "id": "scrap_tech_workshop:energy_cell_scrap"},
      "sfx": [{"id": "minecraft:block.comparator.click", "volume": 0.4, "pitch": 1.2}]
    },
    {
      "text": "jede Scherbe aus Schaltkreisen",
      "displayEntity": {"type": "item", "id": "scrap_tech_workshop:circuit_scrap"}
    },
    {
      "text": "ist eine Chance zum Wiederaufbau.",
      "displayEntity": {"type": "block", "id": "minecraft:crafting_table", "scale": 0.45},
      "sfx": [{"id": "minecraft:block.beacon.activate", "volume": 0.8, "pitch": 0.9}],
      "fx": [{"id": "minecraft:dust", "color": "#00FFAA"}]
    },
    {
      "text": "Das Zeitalter polierter Legierungen"
    },
    {
      "text": "und perfekter Maschinen ist vorbei.",
      "displayEntity": {"type": "item", "id": "minecraft:broken_elytra", "scale": 0.6},
      "sfx": [{"id": "minecraft:entity.elder_guardian.curse", "volume": 0.2, "pitch": 0.75}],
      "fx": [{"id": "minecraft:smoke", "count": 6}]
    },
    {
      "text": "Jetzt wird die Zukunft aus Fragmenten geschmiedet.",
      "displayEntity": {"type": "item", "id": "scrap_tech_workshop:alloy_scrap", "scale": 0.5},
      "sfx": [
        {"id": "minecraft:block.note_block.hat", "volume": 0.8},
        {"id": "minecraft:entity.enderman.teleport", "volume": 0.15, "pitch": 1.6}
      ],
      "fx": [{"id": "minecraft:portal", "count": 6}]
    },
    {
      "text": "Aus Wrackteilen.",
      "displayEntity": {"type": "item", "id": "scrap_tech_workshop:tech_scrap", "scale": 0.4},
      "sfx": [{"id": "minecraft:ui.toast.in"}],
      "fx": [{"id": "minecraft:crit", "count": 10}]
    },
    {
      "text": "Aus Schrott.",
      "displayEntity": {"type": "item", "id": "scrap_tech_workshop:iron_scrap", "scale": 0.4},
      "sfx": [{"id": "minecraft:block.beacon.deactivate"}],
      "fx": [{"id": "minecraft:flash"}]
    }
  ],
  "end": {
    "sfx": [
      {"id": "minecraft:block.beacon.deactivate", "volume": 0.9},
      {"id": "minecraft:ui.toast.in"}
    ],
    "fx": [{"id": "minecraft:flash"}]
  }
}
