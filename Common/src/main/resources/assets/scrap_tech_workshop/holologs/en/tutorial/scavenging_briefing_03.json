{
  "id": "scrap_tech_workshop:holologs/en/tutorial/scavenging_briefing_03",
  "title": "Scavenging Briefing 03",
  "subtitle": "Construct and operate the Scrap Multitool.",
  "color": "#AA00FF",
  "lineDelay": 3.0,
  "voiceOver": "scrap_tech_workshop:holologs/en/tutorial/scavenging_briefing_03",
  "voiceOverDelay": 3.0,
  "displayHoloEntity": {
    "id": "scrap_tech_workshop:hololog_humanoid",
    "texture": "scrap_tech_workshop:textures/entity/hololog/hololog_humanoid.png",
    "scale": 0.5
  },
  "start": {
    "playSound": [{"id": "minecraft:block.note_block.hat", "volume": 0.8}],
    "showParticle": [{"id": "minecraft:dust", "color": "#00FFAA"}]
  },
  "lines": [
    {
      "text": "Assembly protocol unlocked.",
      "playSound": [{"id": "minecraft:block.lever.click", "volume": 0.7}]
    },
    {
      "text": "The Scrap Multitool is now ready for construction.",
      "displayItem": {"id": "scrap_tech_workshop:scrap_multitool"}
    },
    {
      "text": "It merges primitive mechanics with recovered technology.",
      "playSound": [{"id": "minecraft:block.iron_trapdoor.open", "volume": 0.4}]
    },
    {
      "text": "Holographic energy flows through a reinforced frame.",
      "displayItem": {"id": "scrap_tech_workshop:scrap_multitool"}
    },
    {
      "text": "To assemble it, follow this schematic:",
      "displayRecipe": {
        "recipe": "scrap_tech_workshop:scrap_multitool",
        "scale": 1.2
      },
      "playSound": [{"id": "minecraft:block.anvil.use", "volume": 0.6}],
      "lineDelay": 4.5
    },
    {
      "text": "Use metal scrap for housing and handle.",
      "displayItem": {"id": "scrap_tech_workshop:metal_scrap"},
      "playSound": [{"id": "minecraft:block.netherite_block.place", "volume": 0.3}]
    },
    {
      "text": "Add circuit scrap to form the control matrix.",
      "displayItem": {"id": "scrap_tech_workshop:circuit_scrap"},
      "playSound": [{"id": "minecraft:block.copper.place", "volume": 0.3}]
    },
    {
      "text": "Insert quartz to stabilize the holographic core.",
      "displayItem": {"id": "minecraft:quartz"},
      "playSound": [{"id": "minecraft:block.amethyst_block.hit", "volume": 0.4}]
    },
    {
      "text": "Mount a charged Energy Cell to power the device.",
      "displayItem": {"id": "scrap_tech_workshop:energy_cell"},
      "playSound": [{"id": "minecraft:block.beacon.activate", "volume": 0.8}]
    },
    {
      "text": "Each Energy Cell holds ten thousand energy units.",
      "displayItem": {"id": "scrap_tech_workshop:energy_cell"}
    },
    {
      "text": "Different actions consume different amounts.",
      "displayItem": {"id": "scrap_tech_workshop:scrap_multitool"}
    },
    {
      "text": "Mining or digging costs 2 units per block.",
      "displayBlock": {"id": "minecraft:stone"},
      "playSound": [{"id": "minecraft:block.stone.break", "volume": 0.4}]
    },
    {
      "text": "Simple interactions drain 1 unit.",
      "displayBlock": {"id": "minecraft:crafting_table"}
    },
    {
      "text": "Combat attacks consume 5 units per strike.",
      "playSound": [{"id": "minecraft:entity.player.attack.sweep", "volume": 0.5}]
    },
    {
      "text": "Low energy reduces tool speed and efficiency.",
      "displayItem": {"id": "scrap_tech_workshop:scrap_multitool"}
    },
    {
      "text": "Open the interface with Shift + Right-click.",
      "playSound": [{"id": "minecraft:block.iron_door.open", "volume": 0.5}]
    },
    {
      "text": "The center slot holds your Energy Cell.",
      "displayItem": {"id": "scrap_tech_workshop:energy_cell"}
    },
    {
      "text": "Four module slots are reserved for upgrades.",
      "displayItem": {"id": "scrap_tech_workshop:scrap_multitool"}
    },
    {"text": "Modules expand functionality in later revisions."},
    {"text": "Keep the multitool in your hotbar during use."},
    {"text": "Energy is shown by the durability bar."},
    {
      "text": "Green means full charge, red means nearly empty.",
      "playSound": [{"id": "minecraft:block.note_block.pling", "volume": 0.6}]
    },
    {
      "text": "Each inserted cell syncs its stored charge automatically.",
      "displayItem": {"id": "scrap_tech_workshop:energy_cell"}
    },
    {
      "text": "Cells degrade over time and need replacement.",
      "displayItem": {"id": "scrap_tech_workshop:energy_cell"}
    },
    {
      "text": "Depleted cells can be recycled in the Recycler.",
      "displayBlock": {"id": "scrap_tech_workshop:recycler"},
      "playSound": [{"id": "minecraft:block.piston.extend", "volume": 0.4}]
    },
    {
      "text": "The multitool adapts to different materials.",
      "displayItem": {"id": "scrap_tech_workshop:scrap_multitool"}
    },
    {
      "text": "Stone, wood, soil and sand give matched efficiency.",
      "displayBlock": {"id": "minecraft:oak_log"},
      "playSound": [{"id": "minecraft:block.wood.break", "volume": 0.4}]
    },
    {
      "text": "Combat mode activates when striking entities.",
      "displayEntity": {"id": "minecraft:skeleton"},
      "playSound": [{"id": "minecraft:entity.player.attack.strong", "volume": 0.5}]
    },
    {
      "text": "Each hit consumes extra energy for projection.",
      "displayEntity": {"id": "minecraft:zombie"}
    },
    {
      "text": "Without power, the holographic edge weakens.",
      "displayItem": {"id": "scrap_tech_workshop:scrap_multitool"}
    },
    {
      "text": "Carry spare cells for extended operations.",
      "displayItem": {"id": "scrap_tech_workshop:energy_cell"}
    },
    {"text": "This device is the first step toward modular tools."},
    {
      "text": "Maintain it, upgrade it, keep the energy flowing.",
      "playSound": [{"id": "minecraft:block.beacon.ambient", "volume": 0.6}]
    }
  ],
  "end": {
    "playSound": [
      {"id": "minecraft:block.beacon.deactivate", "volume": 0.9},
      {"id": "minecraft:ui.toast.in"}
    ],
    "showParticle": [{"id": "minecraft:flash"}]
  }
}
